{
  "schema_version": 1,
  "target": {
    "architecture": "arm64",
    "minimum_macos": "13.0"
  },
  "build_tools": {
    "python": "3.14",
    "meson": "1.9.1",
    "ninja": "1.13.0",
    "clang": "Apple Clang from the active Xcode Command Line Tools"
  },
  "build_configuration": {
    "linkage": {
      "ffmpeg_libraries": "static",
      "media_dependencies": "static",
      "libmpv": "shared"
    },
    "ffmpeg": [
      "--arch=arm64",
      "--target-os=darwin",
      "--cc=clang",
      "--cxx=clang++",
      "--enable-static",
      "--disable-shared",
      "--enable-pic",
      "--disable-doc",
      "--disable-debug",
      "--disable-gpl",
      "--disable-version3",
      "--disable-nonfree",
      "--disable-ffplay",
      "--disable-ffprobe",
      "--enable-ffmpeg",
      "--enable-audiotoolbox",
      "--enable-videotoolbox",
      "--enable-securetransport",
      "--enable-pthreads"
    ],
    "freetype": [
      "-Dbrotli=disabled",
      "-Dbzip2=disabled",
      "-Dharfbuzz=disabled",
      "-Dpng=disabled",
      "-Dzlib=internal",
      "-Dtests=disabled"
    ],
    "fribidi": [
      "-Ddocs=false",
      "-Dbin=false",
      "-Dtests=false",
      "-Ddeprecated=false"
    ],
    "harfbuzz": [
      "-Dglib=disabled",
      "-Dgobject=disabled",
      "-Dcairo=disabled",
      "-Dchafa=disabled",
      "-Dicu=disabled",
      "-Dgraphite=disabled",
      "-Dgraphite2=disabled",
      "-Dfreetype=enabled",
      "-Dfontations=disabled",
      "-Dcoretext=disabled",
      "-Dsubset=disabled",
      "-Dtests=disabled",
      "-Dintrospection=disabled",
      "-Ddocs=disabled",
      "-Dutilities=disabled"
    ],
    "libass": [
      "-Dfontconfig=disabled",
      "-Dcoretext=enabled",
      "-Ddirectwrite=disabled",
      "-Dasm=enabled",
      "-Dlibunibreak=disabled",
      "-Dtest=disabled",
      "-Dcompare=disabled",
      "-Dprofile=disabled",
      "-Dfuzz=disabled",
      "-Dcheckasm=disabled"
    ],
    "libplacebo": [
      "-Dvulkan=disabled",
      "-Dopengl=enabled",
      "-Dgl-proc-addr=enabled",
      "-Dglslang=disabled",
      "-Dshaderc=disabled",
      "-Dlcms=disabled",
      "-Ddovi=disabled",
      "-Dlibdovi=disabled",
      "-Dxxhash=disabled",
      "-Dunwind=disabled",
      "-Ddemos=false",
      "-Dtests=false",
      "-Dbench=false"
    ],
    "mpv": [
      "-Dgpl=false",
      "-Dcplayer=false",
      "-Dlibmpv=true",
      "-Dbuild-date=false",
      "-Dcplugins=disabled",
      "-Djavascript=disabled",
      "-Djpeg=disabled",
      "-Dlcms2=disabled",
      "-Dlibarchive=disabled",
      "-Dlibavdevice=disabled",
      "-Dlibbluray=disabled",
      "-Dlua=disabled",
      "-Drubberband=disabled",
      "-Duchardet=disabled",
      "-Dvapoursynth=disabled",
      "-Dzimg=disabled",
      "-Dzlib=disabled",
      "-Dcoreaudio=enabled",
      "-Dgl=enabled",
      "-Dplain-gl=enabled",
      "-Dvulkan=disabled",
      "-Dshaderc=disabled",
      "-Dspirv-cross=disabled",
      "-Dvideotoolbox-gl=disabled",
      "-Dvideotoolbox-pl=disabled",
      "-Dcocoa=disabled",
      "-Dgl-cocoa=disabled",
      "-Dmacos-cocoa-cb=disabled",
      "-Dmacos-media-player=disabled",
      "-Dmacos-touchbar=disabled",
      "-Dswift-build=disabled",
      "-Dmanpage-build=disabled"
    ]
  },
  "patches": [
    {
      "name": "mpv-darwin-utils",
      "target": "mpv 0.41.0",
      "file": "patches/mpv-0.41.0-darwin-utils.patch",
      "sha256": "f08cb4e329bdb78bfc427f995298e7fc1888b93be94f505a188b7c15e2abf670",
      "reason": "Build macOS utility symbols used by CoreAudio and AVFoundation without enabling mpv's Cocoa UI."
    }
  ],
